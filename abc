

# ------------------------------------------------------
# Setup
# ------------------------------------------------------
setup:
    @just check-empty-inventory
    @bash scripts/add-known-host.sh
    just python
    @echo
    @just _echo-info "Setup completed successfully..."
    @just _echo-success "Try running 'just ping' to test access to the server."

python:
    @bash scripts/setup-python-env.sh
    scripts/setup-python-env.sh

# ------------------------------------------------------
# Prompt Inventory
# ------------------------------------------------------
prompt-inventory:
    @just _echo-cyan "📄 Prompting for inventory (hosts.yml)..."
    @bash scripts/inventory.sh

check-empty-inventory:
    @if [ ! -f ansible/inventory/hosts.yml ]; then \
      just _echo-warning "No inventory file found at ansible/inventory/hosts.yml. Creating a new one..."; \
      just prompt-inventory; \
    else \
      just _echo-info "📄 Inventory file already exists; skipping creation."; \
    fi


# ------------------------------------------------------
# Check if Keys Directory is Empty
# ------------------------------------------------------
check-empty-keys:
    @if find ansible/keys -maxdepth 1 -type f -name '*.pub' -print -quit | grep -q .; then \
      just _echo-info "🔑 SSH public key(s) already exist in ansible/keys."; \
    else \
      just _echo-warning "No SSH public keys (*.pub) found in ansible/keys."; \
      bash scripts/select-or-generate-key.sh; \
    fi

# ------------------------------------------------------
# Ansible: Running Playbooks
# ------------------------------------------------------
ping:
    scripts/ping_vm.sh

play:
    @just _echo-cyan "🛠 Running playbook..."
    scripts/run_playbook.sh
